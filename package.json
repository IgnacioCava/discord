{
  "name": "discord-clone",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client/*",
    "server/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn start-front\" \"yarn start-back\" --names \"frontend,backend\" --prefix \"[{name}]\"",
    "start-front": "cd client && yarn dev",
    "start-back": "cd server && yarn dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
