{
  "name": "discord-clone",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client/*",
    "server/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn start-front\" \"yarn start-back\" --names \"frontend,backend\" --prefix \"[{name}]\"",
    "start-front": "cd client && yarn devx",
    "start-back": "cd server && yarn dev",
    "container:build": "docker-compose build",
    "container:up": "bash ./scripts/container-up.sh",
    "container:down": "docker-compose down",
    "cb": "yarn container:build",
    "cu": "yarn container:up",
    "cd": "yarn container:down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

